[Unit]
Description=Sovereign Model Context Protocol Composite Gateway Service
Documentation=man:oomcp(1) https://github.com/openOODA-tools/oomcp
Requires=oomcp.socket
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/oomcp serve
StandardInput=socket
StandardOutput=socket
StandardError=journal

# openOODA Sovereign Systemd Hardening Guidelines
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
PrivateDevices=false
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
