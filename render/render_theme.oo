// # Theme and Terminal Palette Resolver
//
// Logline: Hydrates terminal palette from ~/.openooda/theme.oot for oomcp CLI output.
//
// Setup: Requires FsReadCap and EnvCap. Operates with zero ambient authority.
//
// Beats:
//   1. Resolve theme name from OODA_THEME or ~/.openooda/theme.oot with fallback.
//   2. Provide theme-specific ANSI codes for headers, borders, and status indicators.
//   3. Provide formatting helpers for TUI rendering.

import "std/fs/process/env.oo";

pub fn ansi_esc() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 27));
}

pub fn term_reset() -> String {
    return ansi_esc() + "[0m";
}

pub fn term_bold() -> String {
    return ansi_esc() + "[1m";
}

pub fn term_dim() -> String {
    return ansi_esc() + "[2m";
}

pub fn term_green() -> String {
    return ansi_esc() + "[32m";
}

pub fn term_yellow() -> String {
    return ansi_esc() + "[33m";
}

pub fn term_cyan() -> String {
    return ansi_esc() + "[36m";
}

pub fn term_red() -> String {
    return ansi_esc() + "[31m";
}

pub fn parse_theme_val(line: String, key: String) -> String {
    let trimmed: String = str_trim(line);
    if !str_starts_with(trimmed, key) { return ""; }
    let rest: String = str_trim(str_slice(trimmed, chars_len(key), chars_len(trimmed)));
    if !str_starts_with(rest, "=") { return ""; }
    let mut val: String = str_trim(str_slice(rest, 1, chars_len(rest)));
    if str_starts_with(val, "\"") && str_ends_with(val, "\"") {
        let n: Int = chars_len(val);
        if n >= 2 { val = str_slice(val, 1, n - 1); }
    }
    return val;
}

pub fn parse_theme_key(content: String, key: String) -> String {
    let n: Int = chars_len(content);
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(content, i);
        if c == "\n" {
            let v: String = parse_theme_val(cur, key);
            if v != "" { return v; }
            cur = "";
        } else if c != "\r" {
            cur = cur + c;
        }
        i = i + 1;
    }
    if cur != "" {
        let v: String = parse_theme_val(cur, key);
        if v != "" { return v; }
    }
    return "";
}

pub fn resolve_oomcp_theme(fs: &FsReadCap, env: &EnvCap) -> String {
    let env_theme_res: Result[String, String] = env_get(env, "OODA_THEME");
    let env_theme: String = match env_theme_res { Ok(s) => s, Err(_) => "" };
    if chars_len(str_trim(env_theme)) > 0 {
        return env_theme;
    }
    let env_h: Result[String, String] = env_get(env, "HOME");
    let home: String = match env_h { Ok(s) => s, Err(_) => "" };
    if chars_len(home) == 0 { return "classic"; }
    let p: String = if str_ends_with(home, "/") { home + ".openooda/theme.oot" } else { home + "/.openooda/theme.oot" };
    let res: Result[String, String] = read_file(fs, p);
    if !res.is_ok() { return "classic"; }
    let content: String = match res {
        Ok(c) => c,
        Err(_) => "",
    };
    let theme_name: String = parse_theme_key(content, "theme");
    return if chars_len(theme_name) > 0 { theme_name } else { "classic" };
}
